{
  "name": "@veksa/logger",
  "version": "1.2.0",
  "description": "Lightweight, configurable logging library for JavaScript applications",
  "homepage": "https://github.com/veksa/logger",
  "packageManager": "yarn@4.13.0",
  "author": {
    "name": "Aleksandr Khizhnyi",
    "email": "mendler88@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/veksa/logger.git"
  },
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/cjs/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "console",
    "debug",
    "browser-logging",
    "timestamps"
  ],
  "scripts": {
    "clean": "rimraf lib es dist",
    "build": "yarn clean && tsup",
    "compile": "tsc --noEmit",
    "test": "jest",
    "check-all": "yarn compile && yarn test && yarn build",
    "prepublishOnly": "yarn build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.11",
    "jest": "^30.5.2",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslib": "^2.9.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
